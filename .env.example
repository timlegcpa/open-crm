# Every variable below, with what stops working without it: docs/configuration.md.
#
# Frontend. `npm run dev:bootstrap` writes these into .env.local from your Supabase project,
# or copy this file to .env.local and fill them from Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The site's public address (the same value as SITE_URL below). Only the AI connector needs
# it: with it set, `npm run build` writes dist/.well-known/oauth-authorization-server, which
# the host must serve as application/json. Leave it empty if you do not use the connector.
VITE_SITE_URL=

# Edge functions read their settings from supabase/functions/.env (the bootstrap writes the
# secrets there). Add these when the app is served from a real address:
#   SITE_URL=https://crm.example.com   the browser origin allowed to call the functions, and the
#                                      base of every emailed link (http://localhost:5173 while
#                                      developing): portal invitations and e-signature sends are
#                                      refused without it. Also
#                                      required for group email (each email's unsubscribe link),
#                                      for requests (every request email links to the portal
#                                      or a start link; Send, Remind and the scheduled
#                                      reminders are refused without it) and for the AI
#                                      connector (its sign-in issuer), which needs it
#                                      reachable from the internet
#   ENVIRONMENT=production             stops allowing http://localhost:5173
#   ALLOWED_ORIGINS=                   extra origins, comma-separated (optional)
#   MCP_EXTRA_REDIRECT_URIS=           extra AI assistant OAuth callbacks (optional): exact https
#                                      addresses, comma-separated, no query or fragment; read by
#                                      mcp-oauth
#
# Email and text messages, also in supabase/functions/.env. With no provider set and
# ENVIRONMENT not production, every message is written to the dev_outbox table instead
# of being sent; in production a missing provider is an error, never a silent drop.
#   RESEND_API_KEY=                    Resend API key; turns on real email (portal invitations,
#                                      group email, the owner's notices; in production also
#                                      needed for the two-factor recovery alert)
#   EMAIL_FROM=Example Co <crm@example.com>   sender, on a domain verified in Resend
#   EMAIL_REPLY_TO=                    where replies go (optional)
#   The unsubscribe link opens /unsubscribe on SITE_URL: a static host must serve index.html
#   for that path (an SPA fallback).
#   TWILIO_ACCOUNT_SID=                Twilio account SID (AC...); turns on real text messages
#   TWILIO_AUTH_TOKEN=                 Twilio auth token
#   TWILIO_FROM=                       sending number in E.164 (+1...) or a Messaging Service SID (MG...)
#   RESEND_WEBHOOK_SECRET=             optional: the signing secret of a Resend webhook pointed at
#                                      functions/v1/esign-resend-webhook; records when an e-sign
#                                      email is delivered and opened
#
# Generated once by `npm run dev:bootstrap`; do not edit them or copy them between projects
# (a changed encryption key leaves everything encrypted under the old one unreadable):
#   DOCUMENT_ENCRYPTION_KEY, PII_ENCRYPTION_KEY, CRON_SHARED_SECRET, ESIGN_INTERNAL_TOKEN,
#   ESIGN_SMS_CODE_KEY
#   (PII_ENCRYPTION_KEY also encrypts sensitive request answers: without it they are refused.)
